{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mueller-Systems-Lab/OpenCode-Agenten-Oekosystem/blob/master/bootstrap/manifest.schema.json",
  "title": "URL-only Bootstrap Manifest",
  "type": "object",
  "required": ["schema_version", "ecosystem", "repository", "bootstrap_protocol", "entrypoint", "launcher", "installer", "verifier", "rollback", "supported_platforms", "unsupported_platforms", "required_tools", "minimum_versions", "product_contract", "secure_ai_sandbox", "supported_project_types", "default_mode", "available_modes", "managed_paths", "protected_paths", "generated_paths", "dry_run_required", "idempotence_required", "v2_gate_required", "approval_model", "completion_classification"],
  "properties": {
    "schema_version": { "const": "1" },
    "ecosystem": { "const": "OpenCode-Agenten-Oekosystem" },
    "repository": { "const": "https://github.com/Mueller-Systems-Lab/OpenCode-Agenten-Oekosystem" },
    "bootstrap_protocol": { "const": "url-only-v1" },
    "entrypoint": { "type": "string", "pattern": "^[^/].*$" },
    "launcher": { "const": "bootstrap.mjs" },
    "installer": { "type": "string", "pattern": "^[^/].*$" },
    "verifier": { "type": "string", "pattern": "^[^/].*$" },
    "rollback": { "type": "string", "pattern": "^[^/].*$" },
    "supported_platforms": {
      "type": "array",
      "const": ["linux", "windows-wsl"]
    },
    "unsupported_platforms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macos", "windows-native"],
      "properties": {
        "macos": { "const": "TOOL_GAP_SECURE_SANDBOX" },
        "windows-native": { "const": "TOOL_GAP_SECURE_SANDBOX" }
      }
    },
    "required_tools": {
      "type": "array",
      "allOf": [
        { "contains": { "const": "git" } },
        { "contains": { "const": "node" } },
        { "contains": { "const": "bwrap" } }
      ],
      "items": { "type": "string" }
    },
    "product_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invariant", "host", "source_url", "artifact_classes", "capability_status"],
      "properties": {
        "invariant": { "const": "OCAE_IS_AN_OPENCODE_URL_INSTALLABLE_AGENT_ECOSYSTEM" },
        "host": { "const": "OPENCODE" },
        "source_url": { "const": "https://github.com/Mueller-Systems-Lab/OpenCode-Agenten-Oekosystem" },
        "artifact_classes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installable_product_runtime", "installable_agent_definitions", "installable_governance", "installable_harness_profiles", "installable_plugin_tool_integration", "installer_bootstrap", "development_test_infrastructure", "evaluation_only", "local_developer_state", "volatile_evidence"],
          "properties": {
            "installable_product_runtime": { "type": "array", "items": { "type": "string" } },
            "installable_agent_definitions": { "type": "array", "items": { "type": "string" } },
            "installable_governance": { "type": "array", "items": { "type": "string" } },
            "installable_harness_profiles": { "type": "array", "items": { "type": "string" } },
            "installable_plugin_tool_integration": { "type": "array", "items": { "type": "string" } },
            "installer_bootstrap": { "type": "array", "items": { "type": "string" } },
            "development_test_infrastructure": { "type": "array", "items": { "type": "string" } },
            "evaluation_only": { "type": "array", "items": { "type": "string" } },
            "local_developer_state": { "type": "array", "items": { "type": "string" } },
            "volatile_evidence": { "type": "array", "items": { "type": "string" } }
          }
        },
        "capability_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["core", "provider", "tools", "optional_capabilities"],
          "properties": {
            "core": { "type": "array", "items": { "enum": ["CORE_READY", "CORE_NOT_READY"] } },
            "provider": { "type": "array", "items": { "enum": ["PROVIDER_READY", "PROVIDER_NOT_CONFIGURED"] } },
            "tools": { "type": "array", "items": { "enum": ["TOOLS_READY", "TOOLS_NOT_CONFIGURED"] } },
            "optional_capabilities": { "const": "HOST_DISCOVERED" }
          }
        }
      }
    },
    "minimum_versions": {
      "type": "object",
      "required": ["node", "git", "bwrap"],
      "additionalProperties": { "type": "string" }
    },
    "secure_ai_sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "required_kernel_features", "required_runtime_capabilities", "restricted_container_behavior", "unavailable_behavior", "unsandboxed_fallback", "preflight_before_target_file_operation"],
      "properties": {
        "implementation": { "const": "bubblewrap" },
        "required_kernel_features": {
          "type": "array",
          "allOf": [
            { "contains": { "const": "user_namespaces" } },
            { "contains": { "const": "mount_namespaces" } }
          ]
        },
        "required_runtime_capabilities": {
          "type": "array",
          "allOf": [
            { "contains": { "const": "user_namespace_creation" } },
            { "contains": { "const": "bind_mounts" } },
            { "contains": { "const": "network_namespace" } }
          ]
        },
        "restricted_container_behavior": { "const": "TOOL_GAP_SECURE_SANDBOX" },
        "unavailable_behavior": { "const": "TOOL_GAP_SECURE_SANDBOX" },
        "unsandboxed_fallback": { "const": false },
        "preflight_before_target_file_operation": { "const": true }
      }
    },
    "supported_project_types": { "type": "array", "items": { "type": "string" } },
    "default_mode": { "enum": ["INSTALL_NEW"] },
    "available_modes": { "type": "array", "contains": { "const": "INSTALL_NEW" }, "items": { "enum": ["INSTALL_NEW", "UPDATE_EXISTING", "VERIFY_ONLY", "ROLLBACK"] } },
    "managed_paths": { "type": "array", "items": { "type": "string" } },
    "protected_paths": { "type": "array", "items": { "type": "string" } },
    "generated_paths": { "type": "array", "items": { "type": "string" } },
    "dry_run_required": { "const": true },
    "idempotence_required": { "const": true },
    "v2_gate_required": { "const": true },
    "approval_model": { "const": "effect-based" },
    "completion_classification": { "const": "VERIFIED_IN_SCOPE" }
  },
  "additionalProperties": false
}
