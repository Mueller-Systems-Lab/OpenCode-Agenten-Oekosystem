{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mueller-Systems-Lab/OpenCode-Agenten-Oekosystem/governance/bootstrap-security-profile.schema.json",
  "title": "Bootstrap Security Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "default_policy",
    "allowed_tools",
    "safe_read_allowlist",
    "secret_template_allowlist",
    "sandbox"
  ],
  "properties": {
    "version": { "type": "integer", "const": 2 },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_file_read", "target_file_write", "generic_shell", "network", "secret_read"],
      "properties": {
        "target_file_read": { "const": "DENY_BY_DEFAULT" },
        "target_file_write": { "const": "DENY_BY_DEFAULT" },
        "generic_shell": { "const": "DENY_BY_DEFAULT" },
        "network": { "const": "DENY_BY_DEFAULT" },
        "secret_read": { "const": "ABSOLUTE_DENY" }
      }
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^bootstrap_[a-z_]+$" }
    },
    "safe_read_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "secret_template_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_target_visible", "model_host_home_visible", "action_network", "source_clone"],
      "properties": {
        "model_target_visible": { "const": false },
        "model_host_home_visible": { "const": false },
        "action_network": { "const": "NONE" },
        "source_clone": { "const": "READ_ONLY" }
      }
    }
  }
}
